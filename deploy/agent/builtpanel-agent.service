# Built Panel node agent. Installed by deploy/agent/install.sh, which replaces
# @AGENT_UID@ with the numeric id of the builtpanel-agent user (systemd's %U would
# give root's id in a system unit).
#
# Enrol first, then start:
#   sudo -u builtpanel-agent builtpanel-agent enroll --server … --ca-fingerprint … --token …
#   sudo systemctl enable --now builtpanel-agent
[Unit]
Description=Built Panel node agent
Documentation=https://docs.builtpanel.dev/agent
After=network-online.target user@@AGENT_UID@.service
Wants=network-online.target
# Never start an agent that has no identity; enrolment comes first.
ConditionPathExists=/var/lib/builtpanel-agent/identity.json

[Service]
Type=simple
User=builtpanel-agent
Group=builtpanel-agent
ExecStart=/usr/local/bin/builtpanel-agent run
# The agent's own rootless Docker daemon (ADR 0004), never a root daemon.
Environment=XDG_RUNTIME_DIR=/run/user/@AGENT_UID@
Environment=DOCKER_HOST=unix:///run/user/@AGENT_UID@/docker.sock
Restart=always
RestartSec=5
# A stuck agent should not hang a shutdown.
TimeoutStopSec=30

# --- Hardening: the agent needs the network, its state directory and the
# --- Docker socket, and nothing else. Anything privileged goes through
# --- priv-helper (T02.15), not through this process.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/builtpanel-agent /var/lib/builtpanel-transfers
Environment=BUILTPANEL_AGENT_TRANSFERS=/var/lib/builtpanel-transfers
# read-only, not yes: `yes` also hides /run/user, where the agent's own Docker socket is, and without
# Docker the agent offers no tenant operation at all.
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# The capability report (T02.13) reads /proc/cpuinfo and /proc/meminfo, so /proc is not restricted to pids.
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
