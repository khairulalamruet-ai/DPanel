{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@builtpanel/ui": ["./packages/ui/src"],
      "@builtpanel/ui/*": ["./packages/ui/src/*"],
      "@builtpanel/api": ["./packages/api/src"],
      "@builtpanel/api/*": ["./packages/api/src/*"],
      "@builtpanel/auth": ["./packages/auth/src"],
      "@builtpanel/auth/*": ["./packages/auth/src/*"],
      "@builtpanel/i18n": ["./packages/i18n/src"],
      "@builtpanel/i18n/*": ["./packages/i18n/src/*"],
      "@builtpanel/shell": ["./packages/shell/src"],
      "@builtpanel/shell/*": ["./packages/shell/src/*"],
      "@builtpanel/modules": ["./packages/modules/src"],
      "@builtpanel/modules/*": ["./packages/modules/src/*"]
    }
  }
}
