# Built Panel root login helper: lets the administrator `root` log in to the panel with this
# server's root password (like WHM). The control plane never runs as root and cannot read
# /etc/shadow; this helper reads root's line, checks one password at a time and answers one
# byte, over a socket that only the panel's user (builtpanel) can open. See apps/root-auth.
#
#   systemd-analyze security --offline=true builtpanel-root-auth.service
[Unit]
Description=Built Panel root login helper
Documentation=https://docs.builtpanel.dev/control-plane
Before=builtpanel-control-api.service

[Service]
Type=simple
# Root only to read /etc/shadow (its owner); no capabilities at all.
User=root
# The socket is created in the panel's group (mode 0660), so no chown is needed.
Group=builtpanel
ExecStart=/usr/local/bin/builtpanel-root-auth --socket /run/builtpanel-root-auth/root-auth.sock --client-user builtpanel
RuntimeDirectory=builtpanel-root-auth
RuntimeDirectoryMode=0750
Restart=always
RestartSec=2

# --- Hardening: it reads one file and answers on one socket.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @raw-io @debug @obsolete @cpu-emulation @clock
UMask=0077
InaccessiblePaths=-/root -/boot -/srv -/var/lib

[Install]
WantedBy=multi-user.target
