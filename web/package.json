{
  "name": "@builtpanel/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:admin": "pnpm --filter @builtpanel/admin dev",
    "dev:client": "pnpm --filter @builtpanel/client dev",
    "build": "pnpm --filter @builtpanel/admin build && pnpm --filter @builtpanel/client build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:api": "pnpm --filter @builtpanel/api generate:api",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @builtpanel/e2e test",
    "check:i18n": "node packages/i18n/scripts/check-translations.mjs",
    "audit": "pnpm audit --audit-level=high",
    "generate:sbom": "cdxgen -t js -o sbom.json",
    "sbom": "cdxgen -t js -o sbom.json"
  },
  "devDependencies": {
    "@cyclonedx/cdxgen": "^12.9.2",
    "@eslint/js": "^9.20.0",
    "@tanstack/react-router": "^1.114.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.1",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "msw": "^2.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
